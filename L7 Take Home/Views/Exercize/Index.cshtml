@model IEnumerable<L7_Take_Home.Models.Exercize>
@{
    ViewData["Title"] = "Index";
}
<div class="container">
    <h2 class="custom-text">Activity List</h2>
    <button class="btn btn-info">
        <a asp-action="Create" class="text-white">
            Add An Activity
        </a>
    </button>
</div>
    @if (Model.Count() > 0)
    {
        <table class="table table-striped border">
            <tr class="table-secondary">
                <th>@Html.DisplayNameFor(model => model.Name )</th>
                <th>@Html.DisplayNameFor(model => model.Date )</th>
                <th> <span>Action</span> </th>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td> @Html.DisplayNameFor(m => item.Name)</td>
                    <td> @Html.DisplayNameFor(m => item.Date)</td>
                </tr>
            }
        </table>
    }
    else
    {
        <div class="alert-info">
            No activties added yet
        </div>
    }